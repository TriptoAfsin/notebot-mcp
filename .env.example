# Every variable is optional; the service boots with none of them set.

PORT=8080
# Public origin, used in OAuth metadata, snippets and install scripts. No trailing slash.
PUBLIC_URL=https://ai.butexnotebot.com

# REQUIRED in production. Signs API keys and OAuth clients, and encrypts auth codes.
# Generate once: openssl rand -base64 48. Rotating it invalidates every issued key.
KEY_SIGNING_SECRET=

# Your personal admin key: unlocks /analytics/mcp (directly, or on the OAuth consent page).
ADMIN_API_KEY=

# Railway references: ${{Postgres.DATABASE_URL}} and ${{Redis.REDIS_URL}}
# Postgres stores key bookkeeping (schema `mcp`, auto-created). Redis shares cache and rate limits.
DATABASE_URL=
REDIS_URL=

# notebot-analytics-go. Use the private network URL on Railway when possible.
ANALYTICS_API_URL=https://analytics-api.butexnotebot.com
# The ADMIN_KEY configured on notebot-analytics-go (needed for user lookups and error logs)
ANALYTICS_ADMIN_KEY=

# Count public MCP tool calls as platform "ai" in NoteBot analytics (needs ANALYTICS_ADMIN_KEY)
REPORT_AI_USAGE=true

# notebot-engine-v2 (NoteBot library + TexGPT). Private network URL on Railway when possible.
ENGINE_API_URL=https://api.butexnotebot.com

# Resend: emails a lost key back to its owner (never shown on screen) and sends welcome copies.
# Railway: ${{notebot-engine-v2.RESEND_API_KEY}}. Sender domain must be verified in Resend.
RESEND_API_KEY=
MAIL_FROM=NoteBot <notebot@t21.dev>
MAIL_REPLY_TO=
RECOVERY_EMAILS_PER_HOUR=3

BUTEX_BASE_URL=https://www.butex.edu.bd

FREE_RATE_PER_MINUTE=120
FREE_RATE_PER_DAY=10000
MAX_KEYS_PER_EMAIL=10
KEY_ISSUES_PER_IP_HOUR=30

# Outgoing email caps (key recovery and welcome emails), so the form can't spam inboxes.
# EMAILS_PER_IP_HOUR=5
# EMAILS_PER_IP_DAY=20
# EMAILS_PER_ADDRESS_DAY=6
# EMAILS_GLOBAL_HOUR=200

# Logging: JSON lines in production (Railway indexes them), readable lines locally.
# LOG_LEVEL=info          # debug | info | warn | error (debug adds health checks and assets)
# LOG_FORMAT=json         # json | pretty
