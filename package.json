  },
  "engines": {
    "bun": ">=1.2.20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
