{
  "name": "notebot-mcp",
  "version": "1.0.0",
  "description": "MCP server for official BUTEX notices and NoteBot analytics, with a free API-key dashboard",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
